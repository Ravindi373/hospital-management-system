# Copy this file to .env and fill in real values. Never commit .env to Git.

# ---- Server ----
NODE_ENV=development
PORT=5000
TZ=Asia/Colombo
# Origins allowed to send requests (the Vite dev server and the API itself)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
# Set to true when the site is served over HTTPS (makes the session cookie Secure and enables HSTS)
COOKIE_SECURE=false
# Set to 1 if the app runs behind a reverse proxy such as Nginx
TRUST_PROXY=

# ---- Database (MySQL 8 / MariaDB 10.6+) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_db
# Use a dedicated account with only SELECT, INSERT, UPDATE, DELETE on hospital_db - not root.
# Put any value that contains # in double quotes, e.g. DB_PASSWORD="Hms#Local2026pw"
DB_USER=hms_app
DB_PASSWORD=change-this-to-a-long-random-password
# Hosted database that needs SSL (e.g. Aiven): DB_SSL=true, and optionally its CA certificate in DB_SSL_CA
DB_SSL=false
DB_SSL_CA=

# ---- Sign-in security ----
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=20
# Sign-up requests allowed per network address per hour
SIGNUP_RATE_LIMIT=10
BCRYPT_ROUNDS=12

# ---- Backups ----
BACKUP_ENABLED=true
# Cron format: minute hour day month weekday. Default = every day at 02:00
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
# Folder relative to backend/ (default ../backups = project root /backups)
BACKUP_DIR=../backups
# Full path to mysqldump if it is not on PATH, e.g. C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=
# Optional separate account for backups (needs SELECT, LOCK TABLES, SHOW VIEW, TRIGGER)
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=

# ---- Notifications (email) ----
# Address used in email links, e.g. http://localhost:5173 in development or https://hms.your-hospital.lk
APP_URL=http://localhost:5173
HOSPITAL_NAME=City General Hospital
# Leave SMTP_HOST empty to write emails to logs/mail-outbox.log instead of sending them.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD="your 16-letter app password"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Patient SMS ----
# SMS_PROVIDER: log (nothing sent - written to logs/sms-outbox.log), notifylk, or twilio
SMS_ENABLED=true
SMS_PROVIDER=log
# Shown at the end of appointment messages, e.g. "Call 011 269 1111 for changes."
HOSPITAL_PHONE=011 269 1111
# Reminders for tomorrow's appointments (cron: minute hour ...). Default 6 pm every day.
SMS_REMINDER_CRON=0 18 * * *
# Notify.lk (https://notify.lk) - Settings page shows your User ID and API key.
# Use NotifyDEMO as the sender ID until Notify.lk approves your own.
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Staff alerts ----
# Pharmacists get a stock summary each morning (default 07:30)
STOCK_ALERT_CRON=30 7 * * *
